{
  "name": "jokeur-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npx ng lint",
    "prettier": "npx prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config src/tests/config/jest.unit.config.ts",
    "test:integration": "jest --config src/tests/config/jest.integration.config.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:unit:watch": "jest --config src/tests/config/jest.unit.config.ts --watch",
    "cypress:open": "cypress open --config-file src/tests/config/cypress.config.ts",
    "cypress:ci": "cypress run --config-file src/tests/config/cypress.config.ts",
    "doc": "node -e \"require('os').platform() === 'win32' ? require('child_process').execSync('start http://127.0.0.1:8080') : require('child_process').execSync('open http://127.0.0.1:8080')\" && compodoc -p tsconfig.doc.json -s",
    "serve:ssr:jokeur_frontend": "node dist/jokeur_frontend/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "angular-eslint": "^21.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-angular": "^0.562.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.19",
    "cypress": "^15.9.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^16.0.0",
    "jsdom": "^27.4.0",
    "prettier": "3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.53.1"
  }
}
